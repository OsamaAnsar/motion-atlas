# apps/web — copy to .env.local
# All browser-visible config must be prefixed NEXT_PUBLIC_.

# Master switch. true = in-browser MockProvider, no API/GPU needed.
NEXT_PUBLIC_DEMO_MODE=true

# Used only when NEXT_PUBLIC_DEMO_MODE=false (Phase 4+).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

NEXT_PUBLIC_MODEL_NAME=Wan 2.2 TI2V 5B
NEXT_PUBLIC_GPU_NAME=NVIDIA GeForce RTX 3070
NEXT_PUBLIC_COMFYUI_URL=http://127.0.0.1:8188
NEXT_PUBLIC_GITHUB_URL=https://github.com/OsamaAnsar/motion-atlas

# Set true after running `node scripts/make-demo-video.mjs`
NEXT_PUBLIC_HAS_DEMO_VIDEO=false
