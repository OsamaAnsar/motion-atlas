# ─────────────────────────────────────────────────────────────────────────────
# Motion Atlas — environment
# Copy to `.env` (backend) and `.env.local` (apps/web) and adjust as needed.
# ─────────────────────────────────────────────────────────────────────────────

# App
APP_ENV=development

# Demo mode: run the whole product with a simulated inference pipeline.
# No GPU / ComfyUI required. Set to `false` once a ComfyUI workflow is in place.
DEMO_MODE=true
# Compress the simulated pipeline (durations divided by this). 1 = realistic.
DEMO_SPEED=1

# ── Frontend (apps/web) — must be prefixed NEXT_PUBLIC_ to reach the browser ──
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-name/motion-atlas
NEXT_PUBLIC_MODEL_NAME=Wan 2.2 TI2V 5B
NEXT_PUBLIC_GPU_NAME=NVIDIA GeForce RTX 3070

# ── ComfyUI (Phase 2) ──
COMFYUI_URL=http://127.0.0.1:8188
# Absolute path to ComfyUI's `output/` directory (leave blank to auto-detect via history API)
COMFYUI_OUTPUT_DIR=

# ── Persistence ──
DATABASE_URL=sqlite:///./motion_atlas.db
# Set false for public deployments to keep prompt text out of the database.
STORE_PROMPTS=true

# ── RTX 3070 safety controls (backend-enforced; frontend mirrors these) ──
MAX_GPU_WORKERS=1
MAX_QUEUE_SIZE=5
MAX_UPLOAD_MB=10

# Reject configs outside these bounds before they ever reach ComfyUI
MAX_WIDTH=832
MAX_HEIGHT=480
MAX_FRAMES=81
MIN_FRAMES=8
MAX_STEPS=40
MIN_STEPS=4

# Conservative defaults for 8 GB VRAM
DEFAULT_WIDTH=640
DEFAULT_HEIGHT=384
DEFAULT_FRAMES=49
DEFAULT_FPS=16

# If free VRAM is below this before a job starts, keep it queued
GPU_START_VRAM_THRESHOLD_MB=2000

# ── Public demo protection ──
# Off by default. Enable when the API is exposed publicly.
ENABLE_RATE_LIMIT=false
# Video generations allowed per IP per day when the limiter is on
PUBLIC_RATE_LIMIT=3

# Uploaded input images are swept after this many hours
UPLOAD_RETENTION_HOURS=24
